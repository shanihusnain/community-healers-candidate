{
  "expo": {
    "name": "community-healers-candidate",
    "slug": "community-healers-candidate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "communityhealerscandidate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#174c3e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shanihusnain.communityhealerscandidate",
      "softwareKeyboardLayoutMode": "resize",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Community Healers to access your photos for document uploads.",
          "cameraPermission": "Allow Community Healers to use your camera for your profile photo.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab153046-9c63-43e1-8396-b1949cfdd224"
      }
    },
    "owner": "shanihusnain",
    "updates": {
      "url": "https://u.expo.dev/ab153046-9c63-43e1-8396-b1949cfdd224"
    }
  }
}
